# Copy this file to .env.local and fill in real values (see README.md "Variables de Entorno").
# .env.local is gitignored — never commit real secrets.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (used by api/predict-role.js) — NEVER prefix these with VITE_,
# that prefix would bundle them into client-side JS and leak them publicly.
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
